# Example environment variables for local development

# Frontend — set the API base used by the Next.js client
NEXT_PUBLIC_API_URL=http://localhost:5083

# Backend — Entity Framework / Npgsql connection string
# Replace with your local or Supabase connection. Keep secrets out of source control.
ConnectionStrings__SupabaseConnection=Host=your-db-host;Port=5432;Database=your-db;Username=your-username;Password=your-password;

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Optional: override the URLs used by dotnet when running (if needed)
# DOTNET_URLS=http://0.0.0.0:5083
